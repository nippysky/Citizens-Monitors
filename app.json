{
  "expo": {
    "name": "Citizen Monitors",
    "slug": "citizen-monitors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "citizenmonitors",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citizenmonitors.app",
      "associatedDomains": [
        "applinks:www.citizenmonitors.com",
        "applinks:citizenmonitors.com"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Citizen Monitor uses your camera so you can capture election evidence, signed result sheets, and incident reports.",
        "NSPhotoLibraryUsageDescription": "Citizen Monitor uses your photo library so you can attach election photos and videos from your gallery.",
        "NSMicrophoneUsageDescription": "Citizen Monitor uses your microphone when recording live incident videos and cumulative result announcement videos.",
        "NSLocationWhenInUseUsageDescription": "Citizen Monitor uses your location to verify that reports and evidence are submitted from the correct polling area.",
        "NSFaceIDUsageDescription": "Citizen Monitor uses Face ID to protect your account when you reopen the app.",
        "LSApplicationQueriesSchemes": [
          "mailto",
          "comgooglemaps",
          "maps",
          "mailto",
          "comgooglemaps",
          "maps"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.citizenmonitors.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.citizenmonitors.com",
              "pathPrefix": "/insights"
            },
            {
              "scheme": "https",
              "host": "www.citizenmonitors.com",
              "pathPrefix": "/press"
            },
            {
              "scheme": "https",
              "host": "citizenmonitors.com",
              "pathPrefix": "/insights"
            },
            {
              "scheme": "https",
              "host": "citizenmonitors.com",
              "pathPrefix": "/press"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#05A39C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withModularHeaders",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05A39C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Citizen Monitor accesses your camera so you can capture signed result sheets, incident evidence, and record live election reports.",
          "microphonePermission": "Citizen Monitor accesses your microphone so audio is included when recording live incident and result videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Citizen Monitor accesses your photos so you can attach election evidence from your gallery.",
          "cameraPermission": "Citizen Monitor accesses your camera so you can capture live election evidence.",
          "microphonePermission": "Citizen Monitor accesses your microphone so recorded election videos can include audio."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Citizen Monitor uses your location to verify that reports are submitted from the correct polling area."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Citizen Monitor uses Face ID to protect your account when you reopen the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#05A39C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-font",
      "expo-dev-client",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.833971126530-i376uf33tnaq8tah00743vh19ngojira"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05dda0f0-269c-4a9d-bbd1-58f9244b69b9"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/05dda0f0-269c-4a9d-bbd1-58f9244b69b9"
    }
  }
}
